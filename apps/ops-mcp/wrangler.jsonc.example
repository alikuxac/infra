{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "OpsMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OpsMCP"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "ops-brain-memory"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ops-brain-db",
      "database_id": "<DATABASE_ID>"
    }
  ]
}
