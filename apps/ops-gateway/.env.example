# Environment Variables Template

# Atlassian Compass Configuration
COMPASS_CLOUD_ID=your-cloud-id-here
ATLASSIAN_SITE_NAME=your-site-name
ATLASSIAN_EMAIL=your-email@example.com

# Secrets (use wrangler secret put)
ATLASSIAN_TOKEN=your-atlassian-api-token
GATEWAY_CLIENT_SECRET=your-gateway-secret
ADMIN_TOKEN=your-admin-token

# KV Namespace ID (from wrangler kv:namespace create)
# Update in wrangler.toml after creating namespace
