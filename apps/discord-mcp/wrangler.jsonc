{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
